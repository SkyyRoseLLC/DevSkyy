{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skyyrose.local/schemas/branded-skills/enhanced-skill-evidence.schema.json",
  "title": "SkyyRose Enhanced Skill Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "candidate_id", "candidate_sha256", "source_sha256", "contract_sha256", "builder_ids", "started_at", "completed_at", "checks", "artifacts", "unknowns", "review", "verdict"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "contract_id": {"type": "string", "pattern": "^skyyrose\\.branded-skill\\.[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "candidate_id": {"type": "string", "minLength": 1},
    "candidate_sha256": {"$ref": "#/$defs/sha256"},
    "source_sha256": {"$ref": "#/$defs/sha256"},
    "contract_sha256": {"$ref": "#/$defs/sha256"},
    "builder_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "checks": {"type": "array", "minItems": 3, "allOf": [{"contains": {"properties": {"id": {"const": "source-hash"}}, "required": ["id"]}}, {"contains": {"properties": {"id": {"const": "contract-schema"}}, "required": ["id"]}}, {"contains": {"properties": {"id": {"const": "candidate-review"}}, "required": ["id"]}}], "items": {"type": "object", "additionalProperties": false, "required": ["id", "status", "method", "artifact_refs"], "properties": {"id": {"type": "string", "minLength": 1}, "status": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_APPLICABLE", "UNKNOWN"]}, "method": {"type": "string", "minLength": 1}, "artifact_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}, "notes": {"type": "string"}}}},
    "artifacts": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "path", "sha256"], "properties": {"id": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}}},
    "unknowns": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "impact", "next_authority"], "properties": {"id": {"type": "string", "minLength": 1}, "impact": {"type": "string", "minLength": 1}, "next_authority": {"enum": ["AUTO", "AUTO_WITH_LOG", "ASK", "FORBIDDEN"]}}}},
    "review": {"type": "object", "additionalProperties": false, "required": ["independent", "reviewer", "reviewed_at"], "properties": {"independent": {"const": true}, "reviewer": {"type": "string", "minLength": 1}, "reviewed_at": {"type": "string", "format": "date-time"}}},
    "verdict": {"enum": ["PASS", "FAIL", "BLOCKED"]}
  },
  "allOf": [
    {"if": {"properties": {"verdict": {"const": "PASS"}}}, "then": {"properties": {"checks": {"not": {"contains": {"properties": {"status": {"enum": ["FAIL", "BLOCKED", "UNKNOWN"]}}, "required": ["status"]}}}, "unknowns": {"maxItems": 0}}}}
  ],
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
