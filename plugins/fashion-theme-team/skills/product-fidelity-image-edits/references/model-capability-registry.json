        "forbidden_parameters": ["input_fidelity"],
        "parameter_policy": {
          "allowed": ["size", "quality", "output_format", "background", "moderation"],
          "required": ["size", "quality", "output_format"],
          "enums": {
            "quality": ["low", "medium", "high", "auto"],
            "output_format": ["png"],
            "background": ["auto", "opaque", "transparent"],
            "moderation": ["auto", "low"]
          }
        },
        "mask": {
          "format": "png",
          "alpha_channel_required": true,
          "alpha_zero_is_editable": true,
          "same_dimensions_as_input": true,
          "max_input_bytes": 50000000
        },
        "required_receipt_fields": [
          "contract_sha256",
          "provider",
          "api_surface",
          "endpoint",
          "requested_model",
          "input_sha256",
          "request_image_sha256s",
          "mask_path",
          "mask_sha256",
          "output_sha256",
          "prompt_sha256",
          "request_parameters",
          "x_request_id",
          "sdk_version"
        ]
