{
  "$schema": "./home.contract.schema.txt",
  "route": "front-page",
  "output": "assets/css/critical/home.min.css",
  "budgetBytes": 16384,
  "assetsPlaceholder": "__SKYYROSE2_ASSETS__",
  "sources": [
    "design-tokens.css",
    "theme.css",
    "collection-world.css",
    "home-page.css",
    "controls.css",
    "global-shell.css",
    "visual-recovery.css",
    "mascot.css"
  ],
  "keepFontFaces": true,
  "keepMedia": [
    "(max-width: 900px)",
    "(max-width: 640px)",
    "(max-width: 48rem)",
    "(max-width: 47.99em)",
    "(max-width: 47.99rem)",
    "(scripting: none)"
  ],
  "baseSelectors": [
    "*",
    "*::before",
    "*::after",
    "html",
    "body",
    "a",
    "button",
    "input",
    "select",
    "textarea",
    "img",
    ":root"
  ],
  "tokens": [
    ".screen-reader-text",
    ".sr2-skip",
    ".sr2-header",
    ".sr2-header__brand",
    ".sr2-header__brand-mark",
    ".sr2-header__menu",
    ".sr2-header__bag",
    ".sr2-header__nav",
    ".sr2-house-header",
    ".sr2-house-header__start",
    ".sr2-house-header__end",
    ".sr2-house-header__direct",
    ".sr2-house-nav",
    ".sr2-brand-media",
    "#skyyrose-mascot-recall",
    ".skyyrose-mascot__recall",
    "[data-sr2-menu]",
    ".sr2-archive",
    ".sr2-archive__inner",
    ".sr2-commerce-notices",
    ".sr2-archive-scene",
    ".sr2-archive-scene__image",
    ".sr2-archive-scene__veil",
    ".sr2-archive-scene__copy",
    ".sr2-archive-scene__intro",
    ".sr2-archive-scene__actions",
    ".sr2-archive-scene__concierge",
    ".sr2-archive-scene__worlds",
    ".sr2-world-index",
    ".sr2-control",
    ".sr2-control--primary",
    ".sr2-control--secondary",
    ".sr2-recovery-motion-toggle",
    "[data-recovery-hero-video]",
    ".is-hero-video-ready",
    "#skyy-hero-stage",
    ".skyy-presence-status"
  ],
  "excludeSelectorPatterns": [
    ":hover",
    ":active",
    ":disabled",
    "\\[aria-disabled",
    "\\[aria-busy",
    "\\[aria-expanded=\"true\"\\]",
    "\\.is-open",
    "\\.is-scrolled",
    "\\.woocommerce-checkout",
    "\\.sr2-overlay-open",
    "\\.sr2-nav-open",
    "\\.sr2-house-nav__",
    "\\.sr2-house-nav\\s",
    "\\.sr2-house-nav\\.",
    "\\.sr2-image-reveal",
    "\\.sr2-reveal",
    "section\\[id\\]",
    "\\[data-collection=",
    "\\.sr2-house-footer",
    "\\.woocommerce\\b",
    "\\.sr2-button",
    "\\.sr2-icon-button",
    "\\.sr2-chip",
    "\\.sr2-pagination",
    "\\.sr2-field",
    "noscript",
    "\\.sr2-archive-artifact",
    "\\.sr2-archive-heir",
    "\\.sr2-archive-oakland",
    "\\.sr2-archive-worlds",
    "\\.sr2-archive-section-head",
    "\\.sr2-archive-legacy",
    "\\.sr2-archive-continue",
    "\\.sr2-archive-town-line",
    "\\.sr2-world-products",
    "\\.sr2-collection-world",
    "\\[data-renderer=",
    "\\[data-motion-paused",
    "\\[data-presence=",
    ":focus-visible",
    "#skyy-hero-chat"
  ],
  "templates": [
    {
      "file": "inc/global-shell.php",
      "from": "function skyyrose2_header()",
      "to": "function skyyrose2_bag_shell()",
      "stripRegions": [
        "<nav id=\"sr2-menu\"[\\s\\S]*?</nav>"
      ]
    },
    {
      "file": "front-page.php",
      "from": "<main id=\"primary\"",
      "to": "</section>"
    }
  ],
  "allowUnstyled": {
    "sr2-header__bag-count": "styled through .sr2-house-header .sr2-header__bag span",
    "sr2-house-nav": "hidden until opened; the bare .sr2-house-nav rule is kept, internals are not first-view",
    "sr2-header__nav": "hidden until opened; the bare rule is kept",
    "sr2-control--secondary": "inherits .sr2-control; its only dedicated rule is a hover state"
  }
}
