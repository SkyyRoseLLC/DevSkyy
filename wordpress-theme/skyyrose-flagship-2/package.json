{
  "name": "skyyrose-flagship-2-theme",
  "version": "2.4.0",
  "private": true,
  "description": "Deterministic build, verification, and marketplace packaging for SkyyRose Flagship 2.",
  "license": "GPL-2.0-or-later",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "build": "npm run build:registry && npm run build:assets && npm run build:i18n",
    "build:registry": "python3 scripts/build-product-presentation-registry.py",
    "build:assets": "node scripts/build-assets.mjs",
    "build:i18n": "python3 scripts/build-pot.py",
    "check:assets": "node scripts/build-assets.mjs --check",
    "check:i18n": "python3 scripts/build-pot.py --check",
    "check:registry": "python3 scripts/build-product-presentation-registry.py --check",
    "check:provisioning": "php scripts/test-marketplace-registry.php",
    "lint:php": "find . -name '*.php' -not -path './vendor/*' -print0 | xargs -0 -n1 php -l",
    "verify": "bash scripts/verify-marketplace.sh",
    "verify:workspace": "bash scripts/verify-v2-workspace.sh",
    "package:theme": "bash scripts/package-theme.sh"
  },
  "devDependencies": {
    "clean-css": "5.3.3",
    "terser": "5.36.0"
  }
}
