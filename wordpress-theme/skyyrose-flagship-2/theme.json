{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1440px"
    },
    "color": {
      "custom": true,
      "customDuotone": false,
      "customGradient": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "link": true,
      "palette": [
        { "name": "Concrete Black", "slug": "concrete-black", "color": "#0A0A0A" },
        { "name": "Surface", "slug": "surface", "color": "#151515" },
        { "name": "White", "slug": "white", "color": "#FFFFFF" },
        { "name": "Text Secondary", "slug": "text-secondary", "color": "#CCCCCC" },
        { "name": "Text Muted", "slug": "text-muted", "color": "#999999" },
        { "name": "Border", "slug": "border", "color": "#2A2A2A" },
        { "name": "Rose Gold", "slug": "rose-gold", "color": "#B76E79" },
        { "name": "Signature Gold", "slug": "signature-gold", "color": "#D4AF37" },
        { "name": "Black Rose Silver", "slug": "black-rose-silver", "color": "#C0C0C0" },
        { "name": "Love Hurts Crimson", "slug": "love-hurts-crimson", "color": "#DC143C" }
      ]
    },
    "spacing": {
      "blockGap": true,
      "margin": true,
      "padding": true,
      "units": [ "px", "rem", "em", "%", "vw", "vh" ],
      "spacingSizes": [
        { "name": "2XS", "slug": "2-xs", "size": "0.375rem" },
        { "name": "XS", "slug": "xs", "size": "0.625rem" },
        { "name": "Small", "slug": "small", "size": "1rem" },
        { "name": "Medium", "slug": "medium", "size": "1.5rem" },
        { "name": "Large", "slug": "large", "size": "2.5rem" },
        { "name": "XL", "slug": "xl", "size": "4rem" },
        { "name": "2XL", "slug": "2-xl", "size": "6rem" }
      ]
    },
    "typography": {
      "customFontSize": false,
      "dropCap": false,
      "fluid": true,
      "fontStyle": true,
      "fontWeight": true,
      "letterSpacing": true,
      "lineHeight": true,
      "textDecoration": true,
      "textTransform": true,
      "fontSizes": [
        { "name": "Small", "slug": "small", "size": "clamp(0.8125rem, 0.79rem + 0.12vw, 0.875rem)" },
        { "name": "Body", "slug": "body", "size": "clamp(1rem, 0.95rem + 0.2vw, 1.125rem)" },
        { "name": "Lead", "slug": "lead", "size": "clamp(1.125rem, 1rem + 0.6vw, 1.5rem)" },
        { "name": "Display Small", "slug": "display-small", "size": "clamp(1.75rem, 1.35rem + 2vw, 3.25rem)" },
        { "name": "Display", "slug": "display", "size": "clamp(2.5rem, 1.6rem + 4.5vw, 6.5rem)" }
      ],
      "fontFamilies": [
        {
          "name": "Archivo",
          "slug": "archivo",
          "fontFamily": "'Archivo', system-ui, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Archivo",
              "fontStyle": "normal",
              "fontWeight": "100 900",
              "fontDisplay": "swap",
              "src": [ "file:./assets/sot/fonts/archivo-latin.woff2" ]
            }
          ]
        },
        {
          "name": "Hanken Grotesk",
          "slug": "hanken-grotesk",
          "fontFamily": "'Hanken Grotesk', 'Inter', sans-serif",
          "fontFace": [
            {
              "fontFamily": "Hanken Grotesk",
              "fontStyle": "normal",
              "fontWeight": "100 900",
              "fontDisplay": "swap",
              "src": [ "file:./assets/sot/fonts/hanken-grotesk-latin.woff2" ]
            }
          ]
        },
        {
          "name": "Anton",
          "slug": "anton",
          "fontFamily": "'Anton', sans-serif",
          "fontFace": [
            {
              "fontFamily": "Anton",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "src": [ "file:./assets/sot/fonts/anton-latin.woff2" ]
            }
          ]
        },
        {
          "name": "Cinzel",
          "slug": "cinzel",
          "fontFamily": "'Cinzel', Georgia, serif",
          "fontFace": [
            {
              "fontFamily": "Cinzel",
              "fontStyle": "normal",
              "fontWeight": "400 900",
              "fontDisplay": "swap",
              "src": [ "file:./assets/sot/fonts/cinzel-latin.woff2" ]
            }
          ]
        }
      ]
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "custom": {
      "motion": {
        "house-ease": "cubic-bezier(.16, 1, .3, 1)",
        "fast": "180ms",
        "standard": "600ms"
      },
      "focus": {
        "color": "#D4AF37",
        "width": "2px",
        "offset": "3px"
      }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--concrete-black)",
      "text": "var(--wp--preset--color--white)"
    },
    "spacing": {
      "blockGap": "var(--wp--preset--spacing--medium)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--hanken-grotesk)",
      "fontSize": "var(--wp--preset--font-size--body)",
      "lineHeight": "1.65"
    },
    "elements": {
      "button": {
        "color": {
          "background": "var(--wp--preset--color--rose-gold)",
          "text": "var(--wp--preset--color--white)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--anton)",
          "fontWeight": "400",
          "letterSpacing": "0.08em",
          "textTransform": "uppercase"
        },
        "border": {
          "radius": "0"
        }
      },
      "caption": {
        "color": {
          "text": "var(--wp--preset--color--text-muted)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--cinzel)",
          "fontSize": "var(--wp--preset--font-size--small)",
          "letterSpacing": "0.08em",
          "textTransform": "uppercase"
        }
      },
      "h1": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--archivo)",
          "fontSize": "var(--wp--preset--font-size--display)",
          "fontWeight": "800",
          "letterSpacing": "-0.045em",
          "lineHeight": "0.95"
        }
      },
      "h2": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--archivo)",
          "fontSize": "var(--wp--preset--font-size--display-small)",
          "fontWeight": "750",
          "letterSpacing": "-0.035em",
          "lineHeight": "1"
        }
      },
      "h3": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--archivo)",
          "fontSize": "var(--wp--preset--font-size--lead)",
          "fontWeight": "700",
          "lineHeight": "1.2"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--signature-gold)"
        }
      }
    }
  }
}
