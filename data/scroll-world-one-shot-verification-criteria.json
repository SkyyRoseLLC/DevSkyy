  "thresholds": {
    "source_hash_integrity": 100,
    "product_fidelity": 100,
    "scene_canon_fidelity": 100,
    "wearer_assignment_accuracy": 100,
    "logo_and_lettering_accuracy": 100,
    "optical_integration_minimum": 95,
    "anatomy_and_body_contact_minimum": 95,
    "hard_failures_allowed": 0
  },
  "stage_model": {
    "source_preflight": "Physical references, founder-selected model identities, exact hero plate/graphic, hashes, prompt locks, and forbidden inputs must pass before a provider call.",
    "candidate_postflight": "Every visible product feature and hero anchor is checked against source pixels; natural integration is checked at full frame and 200 percent detail crops.",
    "motion_postflight": "The accepted still is the only first frame; all product wearers remain visible; no cut, portal, environment-only tail, text mutation, logo mutation, garment mutation, or anatomy drift is allowed."
  },
  "global_hard_rejects": [
    "generic_environment_or_random_collection_product",
    "rejected_full_frame_scene_used_as_a_generation_reference",
    "historical_five_world_pack_used_as_current_scene_authority",
    "product_or_model_layer_redrawn_when_foreground_only_reuse_is_declared",
    "invented_text_label_patch_logo_or_garment_decoration",
    "wrong_bridge_wrong_statue_wrong_rose_or_approximate_hero_graphic",
    "separate_floor_planes_or_conflicting_light_shadow_reflection_fields",
    "floating_feet_pasted_edges_haloing_scale_mismatch_or_missing_contact_shadow",
    "candidate_marked_wireable_published_or_deployed_before_founder_promotion_receipt"
  ],
  "provider_policy": {
    "source_authority_route": "gpt-image-2 reference-bound candidate generation or masked/localized edit only",
    "environment_route": "protected foreground composite into an exact hash-bound hero plate; Higgsfield may animate or integrate only after source and postflight gates pass",
    "full_frame_product_redraw_allowed": false,
    "rejected_environment_reuse_allowed": false,
    "rejected_edit_foreground_identity_reuse_allowed": true,
    "provider_submission_allowed": false,
    "cost_control_state": "OPERATOR_PAUSED_ALL_PAID_CALLS",
    "resume_condition": "Founder explicitly resumes generation after reviewing the exact source proof board, edit mask, and scene-specific submission receipt.",
    "output_state": "CANDIDATE_QUARANTINED_PENDING_INDEPENDENT_VISUAL_QA_AND_FOUNDER_REVIEW",
    "runtime_wiring_allowed": false,
    "deployment_allowed": false
  },
